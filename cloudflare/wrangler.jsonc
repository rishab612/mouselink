{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mouselink-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "RelaySession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelaySession"] }],
  "vars": { "ALLOWED_WEB_ORIGINS": "https://mouselink-ecru.vercel.app" }
}
